diff --git a/c10/util/DatUtils.h b/c10/util/DatUtils.h
new file mode 100644
index 0000000000000000000000000000000000000000..7158b36792dc4d1841ffe09c0c1918bdbb1d152f
--- /dev/null
+++ b/c10/util/DatUtils.h
@@ -0,0 +1,177 @@
+#ifndef C10_UTIL_DATUTILS_H_
+#define C10_UTIL_DATUTILS_H_
+
+#include <c10/macros/Macros.h>
+// #include <c10/util/Exception.h>
+
+
+#include <cstddef>
+#include <mutex>
+#include <cstdio>
+#include <cstdlib>
+#include <iostream>
+#include <fstream>
+#include <string>
+#include <unistd.h>
+// #include <string>
+
+namespace c10 {
+    namespace detail {
+        
+        // Env variable utilities
+        static std::string getModelNameFromArgs() {
+            const char* model_name = std::getenv("PYTORCH_MODEL_NAME");
+            return model_name ? std::string(model_name) : "";
+        }
+
+        static std::string getGpuNameAffixFromArgs() {
+            const char* gpu_name = std::getenv("GPU_NAME");
+            return gpu_name ? "_" + std::string(gpu_name) : "";
+        }
+
+        static std::string getGpuNameFromArgs() {
+            const char* gpu_name = std::getenv("GPU_NAME");
+            return gpu_name ? std::string(gpu_name) : "";
+        }
+
+        static std::string getTraceDirFromEnv() {
+            const char* trace_dir = std::getenv("TRACE_DIR");
+            if (trace_dir == nullptr || trace_dir[0] == '\0') {
+                return "tmp_trace";
+            }
+            return std::string(trace_dir);
+        }
+        // Env variable utilities end
+
+        // Usage: c10::detail::TensorIdGenerator generator;
+        class TensorIdGenerator {
+        private:
+            size_t id_counter = 0;
+        public:
+            TensorIdGenerator() = default;
+
+            size_t generate() {
+                id_counter++;
+                return id_counter;
+            }
+        };
+
+        // static TensorIdGenerator tensor_id_generator;
+
+        class Counter {
+        private:
+            size_t count = 0;
+            std::mutex mtx; // Mutex for thread safety
+        public:
+            Counter() = default;
+
+            size_t increment() {
+                std::lock_guard<std::mutex> lock(mtx); // Lock the mutex
+                return count++;
+            }
+
+            // size_t get() {
+            //     std::lock_guard<std::mutex> lock(mtx); // Lock the mutex
+            //     return count;
+            // }
+
+            void reset() {
+                std::lock_guard<std::mutex> lock(mtx); // Lock the mutex
+                // printf("Resting counter\n");
+                count = 0;
+            }
+        };
+
+        // static Counter op_counter;
+
+        static bool fileExists(const std::string& filename) {
+            std::ifstream file(filename);
+            return file.good();
+        }
+
+        static std::pair<std::string, int> execCommand(const std::string& cmd) {
+            std::string result;
+            int exit_status = -1;
+            FILE* pipe = popen((cmd + " 2>&1").c_str(), "r");
+            if (!pipe) {
+                return {result, exit_status};
+            }
+            char buffer[128];
+            while (fgets(buffer, sizeof(buffer), pipe) != nullptr) {
+                result += buffer;
+            }
+            exit_status = pclose(pipe);
+            if (WIFEXITED(exit_status)) {
+                exit_status = WEXITSTATUS(exit_status);
+            }
+            return {result, exit_status};
+        }
+
+        static void createDirectory(const std::string& dir_name) {
+            execCommand("mkdir -p " + dir_name);
+        }
+
+        static void writeToNewFile(
+            const std::string& dir_name,
+            const std::string& file_name,
+            const std::string& identifier,
+            const std::string& content)
+        {
+            std::string file_path = dir_name + "/" + file_name + "_" + identifier + ".txt";
+            std::ofstream file(file_path, std::ios::out);
+            if (!file.is_open()) {
+                throw std::runtime_error("Failed to create stats file: " + file_path);
+            }
+            file << content << std::endl;
+            file.close();
+        }
+
+        static void appendToFile(
+            const std::string& dir_name,
+            const std::string& file_name,
+            const std::string& identifier,
+            const std::string& content)
+        {
+            std::string gpu_name_affix = getGpuNameAffixFromArgs();
+            std::string file_path = dir_name + "/" + file_name + "_" + identifier + gpu_name_affix + ".txt";
+            std::ofstream file(file_path, std::ios::app);
+            if (!file.is_open()) {
+                throw std::runtime_error("Failed to open stats file: " + file_path);
+            }
+            file << content << std::endl;
+            file.close();
+        }
+
+        static void writeToNewFile(
+            const std::string& dir_name,
+            const std::string& file_name,
+            size_t pid,
+            const std::string& content)
+        {
+            std::string file_path = dir_name + "/" + file_name + "_" + std::to_string(pid) + ".txt";
+            std::ofstream file(file_path, std::ios::out);
+            if (!file.is_open()) {
+                throw std::runtime_error("Failed to create stats file: " + file_path);
+            }
+            file << content << std::endl;
+            file.close();
+        }
+
+        static void appendToFile(
+            const std::string& dir_name,
+            const std::string& file_name,
+            size_t pid,
+            const std::string& content)
+        {
+            std::string file_path = dir_name + "/" + file_name + "_" + std::to_string(pid) + ".txt";
+            std::ofstream file(file_path, std::ios::app);
+            if (!file.is_open()) {
+                throw std::runtime_error("Failed to open stats file: " + file_path);
+            }
+            file << content << std::endl;
+            file.close();
+        }
+    }
+} // namespace c10
+
+#endif // C10_UTIL_DATUTILS_H_

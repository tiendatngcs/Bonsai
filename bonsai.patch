+        assert model_name, "Model name must be provided for ForwardMemoryRecorder to work"
+
+        if device == "cuda":
+            torch.cuda.synchronize()
+            
+        # store memory consumption after each leaf module
+        self._memory_usages = []
+
+        self._register_hooks()
+        self._register_pre_hooks()
+        
+    def _pre_hook(self, module, inp):
+        if self.device != "cuda":
+            return
+
+        torch.cuda.synchronize()
+
+        allocated = torch.cuda.memory_allocated()
+        module._mem_pre_fwd_allocated = allocated
+        
+        assert module._variable_name is not None, "Module variable name is not set, this should not happen as long as the hooks are properly registered and at least one leaf module is executed during forward pass"
+
+
+    def _hook(self, module, inp, out):
+        if self.device != "cuda":
+            return
+
+        torch.cuda.synchronize()
+
+        allocated = torch.cuda.memory_allocated()
+        reserved = torch.cuda.memory_reserved()
+
+        # memory delta caused by this module
+        module._mem_fwd_allocated = allocated - module._mem_pre_fwd_allocated
+
+        # # update tracker
+        # self.prev_allocated = allocated
+        
+        # if this module is a leaf module, record current memory allocation
+        if len(list(module.named_modules())) == 1:
+            self._memory_usages.append(allocated)
+            
+        # also record size of input for the case this module is checkpointed
+        # module._mem_input = np.sum([i.numel() * i.element_size() for i in inp if torch.is_tensor(i)])
+        # module._mem_input = sum([i.numel() * i.element_size() for i in inp if torch.is_tensor(i)])
+        module._mem_input = 0
+        for i in inp:
+            if torch.is_tensor(i):
+                module._mem_input += i.numel() * i.element_size()
+
+    def _register_hooks(self):
+        for m in self.model.modules():
+            handle = m.register_forward_hook(self._hook)
+            self.handles.append(handle)
+            
+    def _register_pre_hooks(self):
+        for m in self.model.modules():
+            handle = m.register_forward_pre_hook(self._pre_hook)
+            self.handles.append(handle)
+
+    def remove(self):
+        for h in self.handles:
+            h.remove()
+            
+    def average_memory_usage(self):
+        # if not hasattr(self, "memory_usages") or not self.memory_usages:
+        #     return 0
+        assert hasattr(self, "_memory_usages") , "No attribute memory_usages found, this should not happen as long as the hooks are properly registered and at least one leaf module is executed during forward pass"
+        total = sum(self._memory_usages)
+        return total / len(self._memory_usages)
